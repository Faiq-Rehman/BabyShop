        Card(
          child: ListTile(
            leading: const Icon(Icons.favorite_border, color: _green),
            title: const Text('Wishlist'),
            trailing: const Icon(Icons.chevron_right),
            onTap: () => _openWishlist(context),
          ),
        ),
        Card(
          child: ListTile(
            leading: const Icon(Icons.help_outline, color: _green),
            title: const Text('Contact support'),
            trailing: const Icon(Icons.chevron_right),
            onTap: () => Navigator.of(context).push(
              MaterialPageRoute<void>(builder: (_) => const SupportPage()),
            ),
          ),
        ),
        const SizedBox(height: 16),
      ],
    );
  }
}

class OrdersPage extends StatelessWidget {
  const OrdersPage({super.key});

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: const Text('My orders')),
      body: StreamBuilder<QuerySnapshot<Map<String, dynamic>>>(
        stream: context.read<ShopRepository>().orders(),
        builder: (context, snapshot) {
          if (snapshot.hasError) {
            return StoreMessageState(
              icon: Icons.error_outline,
              title: 'Orders unavailable',
              message: '${snapshot.error}',
            );
          }
          if (!snapshot.hasData) return const _LoadingScreen();
          final orders = snapshot.data!.docs;
          if (orders.isEmpty) {
            return const StoreMessageState(
              icon: Icons.receipt_long_outlined,
              title: 'No orders yet',
              message: 'Your order history will appear here.',
            );
          }
          return ListView.builder(
            primary: false,
            padding: const EdgeInsets.all(16),
            itemCount: orders.length,
            itemBuilder: (context, index) {
              final orderDocument = orders[index];
              final data = orderDocument.data();
              final amount = (data['total'] as num?)?.toDouble() ?? 0;
              final createdAt = data['createdAt'];
              final orderDate = createdAt is Timestamp
                  ? createdAt.toDate().toLocal()
                  : null;
              return Card(
                child: ListTile(
                  title: Text('Order ${orderDocument.id.substring(0, 8)}'),
                  subtitle: Text(
                    '${orderDate == null ? 'Date unavailable' : MaterialLocalizations.of(context).formatMediumDate(orderDate)} · '
                    '${data['status'] ?? 'Pending'} · '
                    '${data['itemCount'] ?? 0} items',
                  ),
                  trailing: Row(
                  mainAxisSize: MainAxisSize.min,
                  children: [
                    Text(
                      '\$${amount.toStringAsFixed(2)}',
                      style: const TextStyle(fontWeight: FontWeight.w700),
                    ),
                    const SizedBox(width: 6),
                    const Icon(Icons.chevron_right, color: _green),
                  ],
                ),
                onTap: () => Navigator.of(context).push(
                  MaterialPageRoute<void>(
                    builder: (_) => OrderTrackingPage(
                      orderId: orderDocument.id,
                      order: data,
                    ),
                  ),
                ),
              ),
            );
            },
          );
        },
      ),
    );
  }
}


class OrderTrackingPage extends StatelessWidget {
  const OrderTrackingPage({required this.orderId, required this.order, super.key});

  final String orderId;
  final Map<String, dynamic> order;

  static const _steps = <String>[
    'pending', 'confirmed', 'processing', 'shipped', 'out_for_delivery', 'delivered',
  ];

  @override
  Widget build(BuildContext context) {
    final status = (order['status'] as String? ?? 'pending').toLowerCase();
    final cancelled = status == 'cancelled';
    final currentIndex = _steps.indexOf(status);
    final history = (order['statusHistory'] as List<dynamic>? ?? const []);
    final orderItems = (order['items'] as List<dynamic>? ?? const [])
        .whereType<Map>()
        .toList();
    final recorded = <String>{'pending'};
    for (final entry in history) {
      if (entry is Map && entry['status'] is String) recorded.add(entry['status'] as String);
    }
    return Scaffold(
      appBar: AppBar(title: const Text('Track your order')),
      body: ListView(
        padding: const EdgeInsets.all(20),
        children: [
          Card(
            child: Padding(
              padding: const EdgeInsets.all(18),
              child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
                const Text('ORDER REFERENCE', style: TextStyle(fontSize: 10, letterSpacing: 1.2, fontWeight: FontWeight.w800, color: Colors.black54)),
                const SizedBox(height: 6),
                Text('#${orderId.substring(0, orderId.length > 8 ? 8 : orderId.length).toUpperCase()}', style: const TextStyle(fontSize: 20, fontWeight: FontWeight.w800, color: _darkGreen)),
                const SizedBox(height: 8),
                Text('${order['itemCount'] ?? 0} items · \$${((order['total'] as num?)?.toDouble() ?? 0).toStringAsFixed(2)}'),
                const SizedBox(height: 12),
                Container(padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 7), decoration: BoxDecoration(color: cancelled ? const Color(0xFFFCE9E6) : _softGreen, borderRadius: BorderRadius.circular(30)), child: Text(status.replaceAll('_', ' ').toUpperCase(), style: TextStyle(color: cancelled ? const Color(0xFFB34F45) : _darkGreen, fontSize: 11, fontWeight: FontWeight.w800))),
              ]),
            ),
          ),
          if (orderItems.isNotEmpty) ...[
            const SizedBox(height: 12),
            Card(
              child: Padding(
                padding: const EdgeInsets.all(16),
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.stretch,
                  children: [
                    const Text(
                      'Items ordered',
                      style: TextStyle(
                        color: _darkGreen,
                        fontWeight: FontWeight.w800,
                      ),
                    ),
                    const SizedBox(height: 8),
                    ...orderItems.map((item) {
                      final name = item['name'] as String? ?? 'Product';
                      final quantity =
                          (item['quantity'] as num?)?.toInt() ?? 0;
                      final unitPrice =
                          (item['unitPrice'] as num?)?.toDouble() ?? 0;
                      final lineTotal =
                          (item['lineTotal'] as num?)?.toDouble() ??
                          unitPrice * quantity;
                      return Padding(
                        padding: const EdgeInsets.symmetric(vertical: 5),
                        child: Row(
                          children: [
                            Expanded(
                              child: Text('$name × $quantity'),
                            ),
                            Text('\$${lineTotal.toStringAsFixed(2)}'),
                          ],
                        ),
                      );
                    }),
                  ],
                ),
              ),
            ),
          ],
          const SizedBox(height: 20),
          Text(cancelled ? 'Order cancelled' : 'Delivery progress', style: const TextStyle(fontSize: 20, fontWeight: FontWeight.w800, color: _darkGreen)),
          const SizedBox(height: 14),
          if (cancelled)
            const StoreMessageState(icon: Icons.info_outline, title: 'This order was cancelled', message: 'If you need help with this order, contact our support team.')
          else
            ...List.generate(_steps.length, (index) {
              final step = _steps[index];
              final complete = recorded.contains(step) || (currentIndex >= 0 && index <= currentIndex);
              final active = status == step;
              final title = step.split('_').map((part) => part[0].toUpperCase() + part.substring(1)).join(' ');
              return Padding(
                padding: const EdgeInsets.only(bottom: 4),
                child: Row(crossAxisAlignment: CrossAxisAlignment.start, children: [
                  SizedBox(width: 34, child: Column(children: [
                    Container(width: 27, height: 27, decoration: BoxDecoration(color: complete ? _green : const Color(0xFFE8E8E1), shape: BoxShape.circle), child: Icon(complete ? Icons.check : Icons.circle_outlined, size: 15, color: complete ? Colors.white : Colors.black38)),
                    if (index != _steps.length - 1) Container(width: 2, height: 43, color: complete ? _green.withValues(alpha: .45) : const Color(0xFFE8E8E1)),
                  ])),
                  const SizedBox(width: 10),
                  Expanded(child: Padding(padding: const EdgeInsets.only(top: 3, bottom: 18), child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [Text(title, style: TextStyle(fontWeight: active ? FontWeight.w800 : FontWeight.w600, color: complete ? _darkGreen : Colors.black54)), if (active) const Padding(padding: EdgeInsets.only(top: 4), child: Text('Your order is currently at this stage.', style: TextStyle(fontSize: 12, color: Colors.black54)))]))),
                ]),
              );
            }),
          const SizedBox(height: 12),
          if ((order['address'] as String?)?.isNotEmpty == true)
            Card(
              child: ListTile(
                leading: const Icon(Icons.location_on_outlined, color: _green),
                title: Text(
                  order['deliveryDetails'] is Map &&
                          (order['deliveryDetails'] as Map)['fullName'] is String
                      ? (order['deliveryDetails'] as Map)['fullName'] as String
                      : 'Delivery address',
                ),
                subtitle: Text([
                  if (order['deliveryDetails'] is Map &&
                      (order['deliveryDetails'] as Map)['phone'] is String)
                    (order['deliveryDetails'] as Map)['phone'] as String,
                  order['address'] as String,
                ].join('\n')),
              ),
            ),
        ],
      ),
    );
  }
}

class SupportPage extends StatefulWidget {
  const SupportPage({super.key});

  @override
  State<SupportPage> createState() => _SupportPageState();
}

class _SupportPageState extends State<SupportPage> {
  final _message = TextEditingController();
  bool _busy = false;

  @override
  void dispose() {
    _message.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: const Text('Help & support')),
      body: ListView(
        padding: const EdgeInsets.all(20),
        children: [
          const Text(
            'How can we help?',
            style: TextStyle(fontSize: 22, fontWeight: FontWeight.w800),
          ),
          const SizedBox(height: 8),
          const Text('Send our team a message and we will get back to you.'),
          const SizedBox(height: 18),
          TextField(
            controller: _message,
            minLines: 4,
            maxLines: 6,
            maxLength: 2000,
            decoration: const InputDecoration(
              labelText: 'Your message',
              alignLabelWithHint: true,
            ),
          ),
          const SizedBox(height: 12),
          FilledButton(
            onPressed: _busy
                ? null
                : () async {
                    final text = _message.text.trim();
                    if (text.isEmpty) return;
                    setState(() => _busy = true);
                    try {
                      await context.read<ShopRepository>().submitSupport(text);
                      _message.clear();
                      if (context.mounted) {
                        ScaffoldMessenger.of(context).showSnackBar(
                          const SnackBar(content: Text('Message sent')),
                        );
                      }
                    } catch (error) {
                      if (context.mounted) _showError(context, error);
                    } finally {
                      if (mounted) setState(() => _busy = false);
                    }
                  },
            style: FilledButton.styleFrom(backgroundColor: _green),
            child: Text(_busy ? 'Sending...' : 'Send message'),
          ),
        ],
      ),
    );
  }
}

class _SectionTitle extends StatelessWidget {
  const _SectionTitle({required this.title, this.action, this.onTap});

  final String title;
  final String? action;
  final VoidCallback? onTap;

  @override
  Widget build(BuildContext context) => Row(
    children: [
      Expanded(
        child: Text(
          title,
          style: const TextStyle(
            fontSize: 18,
            fontWeight: FontWeight.w800,
            color: _darkGreen,
          ),
        ),
      ),
      if (action != null) TextButton(onPressed: onTap, child: Text(action!)),
    ],
  );
}

class _SignInPrompt extends StatelessWidget {
  const _SignInPrompt({required this.title, required this.message});

  final String title;
  final String message;

  @override
  Widget build(BuildContext context) => LayoutBuilder(
    builder: (context, constraints) => SingleChildScrollView(
      primary: false,
      child: ConstrainedBox(
        constraints: BoxConstraints(minHeight: constraints.maxHeight),
        child: Center(
          child: Padding(
            padding: const EdgeInsets.all(28),
            child: Column(
              mainAxisSize: MainAxisSize.min,
              children: [
                const Icon(Icons.person_outline, size: 54, color: _green),
                const SizedBox(height: 14),
                Text(
                  title,
                  textAlign: TextAlign.center,
                  style: const TextStyle(
                    fontSize: 19,
                    fontWeight: FontWeight.w700,
                  ),
                ),
                const SizedBox(height: 6),
                Text(message, textAlign: TextAlign.center),
                const SizedBox(height: 18),
                FilledButton(
                  onPressed: () => _openAuth(context),
                  style: FilledButton.styleFrom(backgroundColor: _green),
                  child: const Text('Sign in or create account'),
                ),
              ],
            ),
          ),
        ),
      ),
    ),
  );
}

Future<void> _openAuth(BuildContext context) {
  return Navigator.of(context)
      .push<void>(MaterialPageRoute<void>(builder: (_) => const AuthPage()));
}

Future<bool> _requireSignIn(BuildContext context) async {
  if (FirebaseAuth.instance.currentUser != null) return true;
  await _openAuth(context);
  return FirebaseAuth.instance.currentUser != null;
}

Future<void> _openWishlist(BuildContext context) async {
  if (!await _requireSignIn(context) || !context.mounted) return;
  await Navigator.of(
    context,
  ).push<void>(MaterialPageRoute<void>(builder: (_) => const WishlistPage()));
}

OverlayEntry? _cartSuccessEntry;

void _showCartSuccess(BuildContext context) {
  final overlay = Overlay.of(context);
  _cartSuccessEntry?.remove();
  _cartSuccessEntry?.dispose();
  late final OverlayEntry entry;
  entry = OverlayEntry(
    builder: (_) => _CartSuccessToast(
      onDismiss: () {
        if (!identical(_cartSuccessEntry, entry)) return;
        _cartSuccessEntry = null;
        entry.remove();
        entry.dispose();
      },
    ),
  );
  _cartSuccessEntry = entry;
  overlay.insert(entry);
}

class _CartSuccessToast extends StatefulWidget {
  const _CartSuccessToast({required this.onDismiss});

  final VoidCallback onDismiss;

  @override
  State<_CartSuccessToast> createState() => _CartSuccessToastState();
}

class _CartSuccessToastState extends State<_CartSuccessToast>
    with SingleTickerProviderStateMixin {
  late final AnimationController _controller;
  late final Timer _dismissTimer;

  @override
  void initState() {
    super.initState();
    _controller = AnimationController(
      vsync: this,
      duration: const Duration(milliseconds: 220),
    )..forward();
    _dismissTimer = Timer(const Duration(seconds: 3), () async {
      await _controller.reverse();
      if (mounted) widget.onDismiss();
    });
  }

  @override
  void dispose() {
    _dismissTimer.cancel();
    _controller.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) => Positioned.fill(
    child: IgnorePointer(
      child: SafeArea(
        child: Align(
          alignment: Alignment.topRight,
          child: Padding(
            padding: const EdgeInsets.all(16),
            child: ConstrainedBox(
              constraints: const BoxConstraints(maxWidth: 380),
              child: FadeTransition(
                opacity: _controller,
                child: SlideTransition(
                  position: Tween<Offset>(
                    begin: const Offset(0, -0.15),
                    end: Offset.zero,
                  ).animate(_controller),
                  child: Material(
                    color: Colors.white,
                    elevation: 8,
                    borderRadius: BorderRadius.circular(14),
                    child: const Padding(
                      padding: EdgeInsets.symmetric(
                        horizontal: 16,
                        vertical: 14,
                      ),
                      child: Row(
                        mainAxisSize: MainAxisSize.min,
                        children: [
                          Icon(Icons.check_circle, color: _green),
                          SizedBox(width: 10),
                          Flexible(
                            child: Text(
                              'Product added to cart successfully!',
                              style: TextStyle(fontWeight: FontWeight.w600),
                            ),
                          ),
                        ],
                      ),
                    ),
                  ),
                ),
              ),
            ),
          ),
        ),
      ),
    ),
  );
}

void _showError(BuildContext context, Object error) {
  ScaffoldMessenger.of(context).showSnackBar(
    SnackBar(
      content: Text('Could not complete the action: $error'),
      backgroundColor: const Color(0xFFD9534F),
    ),
  );
}

class WishlistPage extends StatelessWidget {
  const WishlistPage({super.key});

  @override
  Widget build(BuildContext context) => Scaffold(
    appBar: AppBar(title: const Text('Wishlist')),
    body: StreamBuilder<QuerySnapshot<Map<String, dynamic>>>(
      stream: context.read<ShopRepository>().wishlistItems(),
      builder: (context, snapshot) {
        if (snapshot.hasError) {
          return StoreMessageState(
            icon: Icons.error_outline,
            title: 'Wishlist unavailable',
            message: '${snapshot.error}',
          );
        }
        if (!snapshot.hasData) return const _LoadingScreen();
        final items = snapshot.data!.docs;
        if (items.isEmpty) {
          return const StoreMessageState(
            icon: Icons.favorite_border,
            title: 'Your wishlist is empty',
            message: 'Save products you would like to come back to.',
          );
        }
        return ListView.builder(
          padding: const EdgeInsets.all(16),
          itemCount: items.length,
          itemBuilder: (context, index) {
            final item = items[index].data();
            return Card(
              child: ListTile(
                leading: SizedBox(
                  width: 48,
                  child: _ProductImage(url: item['imageUrl'] as String? ?? ''),
                ),
                title: Text(item['name'] as String? ?? 'Product'),
                subtitle: Text(
                  '\$${((item['price'] as num?)?.toDouble() ?? 0).toStringAsFixed(2)}',
                ),
                trailing: IconButton(
                  tooltip: 'Remove from wishlist',
                  onPressed: () => context
                      .read<ShopRepository>()
                      .removeFromWishlist(items[index].id),
                  icon: const Icon(Icons.delete_outline),
                ),
              ),
            );
          },
        );
      },
    ),
  );
}
