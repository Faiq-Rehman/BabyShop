      return ListView(
        primary: false,
        padding: const EdgeInsets.all(20),
        children: [
          const SizedBox(height: 32),
          const Icon(Icons.person_outline, color: _green, size: 64),
          const SizedBox(height: 16),
          const Text(
            'Welcome to BabyShopHub',
            textAlign: TextAlign.center,
            style: TextStyle(
              color: _darkGreen,
              fontSize: 22,
              fontWeight: FontWeight.w800,
            ),
          ),
          const SizedBox(height: 8),
          const Text(
            'You can browse the store as a guest. Sign in to save your cart, '
            'wishlist, and orders.',
