          child: ListTile(
            leading: const CircleAvatar(
              backgroundColor: _softGreen,
              child: Icon(Icons.person_outline, color: _green),
            ),
            title: Text(accountUser.displayName ?? 'BabyShopHub customer'),
            subtitle: Text(accountUser.email ?? ''),
          ),
        ),
        const SizedBox(height: 8),
        Card(
          child: ListTile(
            leading: const Icon(Icons.receipt_long_outlined, color: _green),
            title: const Text('My orders'),
            trailing: const Icon(Icons.chevron_right),
            onTap: () => Navigator.of(
              context,
            ).push(MaterialPageRoute<void>(builder: (_) => const OrdersPage())),
